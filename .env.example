# =================================================================
# QwikConnect - Environment Configuration for Vercel & Production
# =================================================================

# 1. APPLICATION & DOMAIN INFO
NEXT_PUBLIC_APP_NAME="QwikConnect"
# On Vercel: Set to your actual Vercel domain e.g. https://your-project.vercel.app or custom domain https://qwikconnect.ng
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# 2. NEXTAUTH / AUTH.JS
# Must match your public production URL on Vercel
NEXTAUTH_URL="https://your-project.vercel.app"
# Generate a secure 32+ character key (e.g. using openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-secure-random-32-char-secret-key"
AUTH_SECRET="replace-with-a-secure-random-32-char-secret-key"

# 3. DATABASE (MONGODB ATLAS)
# Sign up at https://mongodb.com/cloud/atlas (Free M0 tier)
# Create a cluster, get connection string, and paste here:
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/qwikconnect?retryWrites=true&w=majority"

# Optional MySQL / Prisma connection (if using MySQL backend instead of MongoDB)
# DATABASE_URL="mysql://username:password@host:3306/qwikconnect"

# 4. PAYMENT GATEWAYS
# Paystack (Nigeria & West Africa)
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"

# Flutterwave (Nigeria & Africa)
FLW_PUBLIC_KEY="FLWPUBK_TEST-your_flutterwave_public_key"
FLW_SECRET_KEY="FLWSECK_TEST-your_flutterwave_secret_key"

# Stripe (Global Cards)
STRIPE_PUBLIC_KEY="pk_test_your_stripe_public_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# PayPal
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_SECRET="your_paypal_secret"
PAYPAL_MODE="sandbox" # or "live" for production

# Razorpay (India & Asia)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Mollie (Europe)
MOLLIE_API_KEY=""

# 5. REALTIME LIVE CHAT (PUSHER) - Optional
# Sign up at https://pusher.com for free channels app
PUSHER_APP_ID=""
PUSHER_APP_KEY=""
PUSHER_APP_SECRET=""
PUSHER_APP_CLUSTER="mt1"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# 6. SMTP EMAIL NOTIFICATIONS - Optional
# e.g. Resend, Sendgrid, Postmark, Mailgun, or Gmail
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@qwikconnect.ng"

# 7. SMS NOTIFICATIONS (TWILIO) - Optional
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
